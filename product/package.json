    "@xterm/xterm": "6.0.0",
    "fastify": "5.12.7",
    "node-pty": "1.1.0",
    "playwright-bdd": "9.2.1",
    "typescript": "5.9.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.10",
