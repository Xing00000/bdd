{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "dist",
    "baseUrl": "..",
    "paths": {"*": ["product/node_modules/*", "node_modules/*"]},
    "types": ["node"],
    "typeRoots": ["node_modules/@types", "../node_modules/@types"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmitOnError": true,
    "sourceMap": true
    ,"rewriteRelativeImportExtensions": true
  },
  "include": ["../src/**/*.ts", "../product-tests/**/*.ts"]
}
