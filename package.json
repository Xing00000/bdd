{
  "name": "bdd-workbench-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node tools/completion/run-e2e.mjs",
    "spec:generate": "node tools/completion/generate.mjs",
    "spec:verify": "node tools/completion/verify.mjs",
    "spec:list": "playwright test --list --reporter=list",
    "spec:typecheck": "tsc --noEmit -p completion.tsconfig.json",
    "test:tooling": "node --import ./tools/completion/register-ts.mjs --test tools/completion/tooling.test.mjs",
    "test:checks": "node tools/completion/checks.mjs",
    "test:skeleton:list": "playwright test --config skeleton.config.ts --list --reporter=list",
    "test:skeleton:pending": "playwright test --config skeleton.config.ts --grep 本工作台自身依Git中的確認流程開發"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright-bdd": "9.2.1",
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@cucumber/gherkin": "39.1.0",
    "@cucumber/messages": "32.3.1"
  }
}
