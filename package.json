{
  "name": "bdd-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "npm_config_build_from_source=true npm rebuild node-pty",
    "build": "node tools/build.mjs",
    "deploy": "npm run build && node tools/deploy.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node scripts/workstation.mjs serve",
    "init-fixtures": "node tools/init-fixtures.mjs",
    "serve-fixtures": "node tools/serve-fixtures.mjs",
    "verify": "node tools/verify-app.mjs",
    "test": "playwright test",
    "test:app": "node tools/test.mjs",
    "test:e2e": "playwright test",
    "test:ui:protocol": "playwright test --grep @protocol",
    "spec:generate": "node tools/bdd/generate.mjs",
    "spec:verify": "node tools/bdd/verify.mjs",
    "spec:list": "playwright test --list --reporter=list",
    "spec:typecheck": "tsc --noEmit -p tsconfig.json",
    "test:tooling": "node --import ./tools/bdd/register-ts.mjs --test tests/integration/bdd-tooling.test.mjs",
    "test:checks": "node tools/bdd/checks.mjs",
    "start:repositories": "node scripts/workstation.mjs serve",
    "workstation": "node scripts/workstation.mjs",
    "check:workstation": "node scripts/check-workstation.mjs",
    "test:workstation": "node --test tests/workstation/*.test.mjs",
    "test:seed": "node --test tests/workstation/agent-settings.test.mjs tests/workstation/agent-catalog.test.mjs tests/workstation/prompt-catalog.test.mjs tests/integration/application-seed.test.ts",
    "pretest:chat:runtime": "npm run build",
    "test:chat:runtime": "node --test dist/tests/integration/chat.test.js dist/tests/integration/chat-stream.test.js dist/tests/integration/chat-tool-protocol.test.js dist/tests/integration/copilot-models.test.js dist/tests/integration/codex-chat-runtime.test.js dist/tests/integration/copilot-chat-runtime.test.js dist/tests/integration/chat-provider-lifecycle.test.js dist/tests/integration/chat-service-lifecycle.test.js dist/tests/integration/chat-cli-smoke.test.js dist/tests/integration/chat-native-runtime.test.js",
    "test:workstation:e2e": "node --test --test-concurrency=1 tests/workstation-e2e/*.test.mjs",
    "pretest:tooling": "npm run spec:generate",
    "check:repository": "node scripts/check-repository.mjs",
    "check:unused": "tsc --noEmit -p tsconfig.unused.json",
    "bdd": "node scripts/bdd.mjs"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "19.0.0",
    "@cucumber/gherkin": "39.1.0",
    "@cucumber/messages": "32.3.1",
    "@fastify/websocket": "11.3.4",
    "@github/copilot": "1.0.105",
    "@openai/codex": "0.166.0",
    "@playwright/test": "1.64.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "fastify": "5.12.7",
    "markdown-it": "15.0.3",
    "node-pty": "1.1.0",
    "playwright-bdd": "9.2.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "bin": {
    "bdd": "scripts/bdd.mjs"
  }
}
